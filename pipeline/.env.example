# ---- Gemini (obligatoire) ----------------------------------------------------
# Clé API : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Passe 2 (lieu + actrice) : gemini-3.8-flash. Passe 1 (découpage) : gemini-3.8-flash aussi (Flash-Lite est 2,5x moins cher
# mais rate les cartes pub insérées au début ; l'écart est de 0,1 centime par vidéo).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_SEGMENT=gemini-3.8-flash
# Résolution des images de la passe 2 : LOW | MEDIUM | HIGH (HIGH lit mieux les panneaux, ~1 000 tokens/image)
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
# Réflexion du modèle : MINIMAL | LOW | MEDIUM | HIGH (les tokens de réflexion sont facturés en sortie)
GEMINI_THINKING_LEVEL=LOW
# Prix ($ / million de tokens) utilisés pour l'estimation de coût affichée dans le dashboard
GEMINI_PRICE_INPUT_PER_M=0.75
GEMINI_PRICE_OUTPUT_PER_M=3.75
# Images envoyées : passe 1 une image toutes les N s (planches 4x6) ; passe 2 N images + N s d'audio
FRAME_STEP_SECONDS=4
LOCATE_FRAMES=6
LOCATE_AUDIO_SECONDS=30

# ---- Google Sheet (obligatoire pour `run.py sheet`) --------------------------
SHEET_ID=1VwF5sQOScyDzVDCkkPUUDvsZaQiDH4Fr55UDJbve2lw
SHEET_TAB=Pipeline
# Fichier JSON du compte de service (voir README) ; le Sheet doit être partagé avec son email
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json

# ---- Découverte --------------------------------------------------------------
SEARCH_SITE=https://fr.xvideos.com
# Plusieurs requêtes séparées par des virgules
SEARCH_QUERIES=pick up,vlog,travel vlog,vlog voyage,sightseeing,tourist,city tour
SEARCH_PAGES=3
# Les vidéos plus courtes que ça sont presque toujours des extraits "sexe seulement" (pas de scène de rue)
MIN_SOURCE_DURATION=600

# ---- Découpe / détection -----------------------------------------------------
SCAN_SECONDS=480
NSFW_THRESHOLD=0.45
NSFW_CONSECUTIVE=2
SAFETY_MARGIN=4
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=240
MIN_LOCATION_CONFIDENCE=0.6
KEEP_SOURCE=0

# ---- Optionnel : ignorer les vidéos déjà en base (table videos.source_url) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DASHBOARD_PORT=8765
